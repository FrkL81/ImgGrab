{
  "manifest_version": 3,
  "name": "ImgGrab — Descarga Rápida de Imágenes",
  "version": "1.5",
  "description": "Atraviesa escudos de Instagram, soporta webs antiguas, Shadow DOM, backgrounds CSS y atajos de teclado.",
  "permissions": ["downloads", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "download-center-post": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Descargar la imagen del post central (Ideal para Instagram)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
